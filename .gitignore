# Large or reproducible data artifacts
data/interim/
data/external/
outputs/*
!outputs/figures/
!outputs/figures/.gitkeep
!outputs/tables/
!outputs/tables/.gitkeep
!outputs/reports/
!outputs/reports/.gitkeep
logs/

# Local environments
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
*.log

# Reproducible model binaries are generated by training scripts.
# Keep registries and reports in git, but avoid large classroom-submission blobs.
*.joblib
*.pkl

# Keep lightweight documentation/samples in git
!data/samples/
!data/samples/**
!data/processed/
!data/processed/*.csv
!outputs/reports/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Private manuscript and submission packages
14_CPU研究增强包/
15_核心论文研究包/
16_论文级实证增强包/
17_投稿级研究完善包/
18_投稿成稿与复现发布包/
private_research_archive/
~$*
*.tmp